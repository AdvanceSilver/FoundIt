<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0B12"
    android:clipToPadding="false">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="16dp"
        android:background="#151522"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnChatBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:tint="#FFFFFF"
            android:scaleType="centerInside"/>

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="F"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_glass"
            android:layout_marginStart="5dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/txtChatUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FoundIt User"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="#A78BFA"/>

                <TextView
                    android:id="@+id/txtChatStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Private conversation"
                    android:textColor="#B7A2F5"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"/>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- POSSIBLE MATCH CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="5dp"
        android:padding="13dp"
        android:background="@drawable/bg_glass">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="✦"
            android:textColor="#D2BDFF"
            android:textSize="21sp"
            android:background="#30264B"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POSSIBLE MATCH"
                android:textColor="#BDA5FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/txtChatItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Item name"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIVATE"
            android:textColor="#C9B8FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="#30264B"
            android:paddingHorizontal="9dp"
            android:paddingVertical="6dp"/>

    </LinearLayout>

    <!-- CHAT MESSAGES -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:overScrollMode="never"
        android:scrollbars="none"/>

    <!-- MESSAGE INPUT -->
    <LinearLayout
        android:id="@+id/chatComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:background="#151522"
        android:elevation="8dp">

        <EditText
            android:id="@+id/edtChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="49dp"
            android:maxHeight="112dp"
            android:hint="Write a message..."
            android:textColor="#FFFFFF"
            android:textColorHint="#9691A5"
            android:textSize="15sp"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/bg_chat_input"
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="flagNoExtractUi"
            android:maxLength="3000"
            android:maxLines="4"
            android:gravity="center_vertical"
            android:importantForAutofill="no"/>

        <ImageButton
            android:id="@+id/btnSendChatMessage"
            android:layout_width="49dp"
            android:layout_height="49dp"
            android:layout_marginStart="10dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="@drawable/bg_chat_send"
            android:backgroundTint="@null"
            android:contentDescription="Send message"
            android:tint="#FFFFFF"
            android:padding="13dp"
            android:scaleType="centerInside"/>

    </LinearLayout>

</LinearLayout>

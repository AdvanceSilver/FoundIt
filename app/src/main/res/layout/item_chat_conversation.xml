<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatConversationCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="13dp"
    android:paddingEnd="13dp"
    android:paddingTop="15dp"
    android:paddingBottom="15dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="88dp">

    <!-- Profile avatar -->
    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="#332A2048">

        <ImageView
            android:id="@+id/imgChatAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/txtChatInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="U"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </FrameLayout>

    <!-- Conversation details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="5dp">

        <!-- Username -->
        <TextView
            android:id="@+id/txtConversationUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Latest message -->
        <TextView
            android:id="@+id/txtConversationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start your conversation..."
            android:textColor="#C1BDCE"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="5dp"/>

        <!-- Related item -->
        <TextView
            android:id="@+id/txtConversationItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Matched item"
            android:textColor="#B69AFF"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

    <!-- Message time -->
    <TextView
        android:id="@+id/txtConversationTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:text=""
        android:textColor="#9995A8"
        android:textSize="10sp"
        android:gravity="end"
        android:maxLines="1"/>

</LinearLayout>
